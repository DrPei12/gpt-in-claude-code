{
  "name": "gpt-in-claude-code",
  "version": "0.1.2",
  "private": true,
  "description": "Run GPT-5.6 Codex models inside Claude Code with isolated auth, persistent sessions, and Codex-style context management",
  "type": "module",
  "files": [
    "docs/",
    "skills/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "MAINTAINERS.md",
    "LICENSE",
    "NOTICE.md",
    "UPSTREAM.md",
    "patches/",
    "proxy/",
    "third_party/",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md",
    "SUPPORT.md",
    "bootstrap.ps1",
    "bootstrap.sh",
    "gicc",
    "gicc.cmd",
    "gicc.ps1",
    "gicc-runtime.mjs",
    "claudex",
    "claudex.cmd",
    "claudex.ps1",
    "codex-session",
    "codex-session.ps1",
    "env.example",
    "install.ps1",
    "install.sh",
    "install.zsh",
    "preload.cjs",
    "skill-bridge.cjs",
    "self-update",
    "self-update.ps1",
    "settings.json",
    "statusline",
    "statusline.ps1",
    "usage-limit",
    "usage-limit.ps1"
  ],
  "scripts": {
    "check:docs": "node scripts/check-docs.mjs",
    "check:preload": "node scripts/check-preload.mjs",
    "check:skills": "node tests/skill-bridge.test.cjs && node tests/skill-contract.test.cjs && node tests/skill-security.test.cjs",
    "check:package-bootstrap": "node tests/package-bootstrap-signals.test.cjs",
    "check:package-setup-lock": "node tests/package-setup-lock.test.cjs",
    "check:compatibility": "node scripts/check-compatibility-matrix.mjs",
    "check:dynamic-workflow": "node tests/dynamic-workflow-policy.test.mjs",
    "check:shim": "node tests/claudex-shim.test.mjs",
    "check:diagnostics": "node tests/runtime-diagnostics.test.mjs",
    "check:runtime": "node tests/runtime-session-context.test.mjs",
    "check:public-tree": "node tests/public-tree-policy.test.mjs && node scripts/check-public-tree.mjs",
    "test": "npm run check:docs && npm run check:preload && npm run check:skills && npm run check:package-bootstrap && npm run check:package-setup-lock && npm run check:compatibility && npm run check:dynamic-workflow && npm run check:shim && npm run check:diagnostics && npm run check:runtime && npm run check:public-tree",
    "test:all": "bash ./test.sh",
    "build:release": "bash ./scripts/build-release.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "gicc",
    "claude-code",
    "codex",
    "openai",
    "anthropic",
    "cli",
    "developer-tools",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrPei12/gpt-in-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/DrPei12/gpt-in-claude-code/issues"
  },
  "homepage": "https://github.com/DrPei12/gpt-in-claude-code",
  "license": "MIT"
}
