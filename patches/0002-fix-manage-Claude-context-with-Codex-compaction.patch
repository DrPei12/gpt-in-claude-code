@@ -0,0 +1,365 @@
+package executor
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+
+	internalcache "github.com/router-for-me/CLIProxyAPI/v7/internal/cache"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+// prepareCodexClaudeContext reconciles Claude Code's full transcript with the
+// persisted model-visible checkpoint. Compaction runs after reasoning replay is
+// inserted so the budget reflects the exact upstream request.
+func (e *CodexExecutor) prepareCodexClaudeContext(
+	ctx context.Context,
+	req cliproxyexecutor.Request,
+	opts cliproxyexecutor.Options,
+	baseModel string,
+	body []byte,
+) ([]byte, *helps.ClaudeCodeContextPreparation, error) {
+	if !sourceFormatEqual(opts.SourceFormat, sdktranslator.FormatClaude) {
+		return body, nil, nil
+	}
+	preparation, err := helps.PrepareClaudeCodeContext(ctx, e.cfg, baseModel, req.Payload, opts.Headers, body)
+	if err != nil || preparation == nil {
+		return body, preparation, err
+	}
+	return preparation.Body, preparation, nil
+}
+
+func (e *CodexExecutor) compactCodexClaudeContextIfNeeded(
+	ctx context.Context,
+	auth *cliproxyauth.Auth,
+	req cliproxyexecutor.Request,
+	opts cliproxyexecutor.Options,
+	from sdktranslator.Format,
+	baseModel string,
+	baseURL string,
+	apiKey string,
+	originalPayloadSource []byte,
+	preparation *helps.ClaudeCodeContextPreparation,
+) ([]byte, bool, error) {
+	if preparation == nil || !preparation.Enabled {
+		if preparation == nil {
+			return nil, false, nil
+		}
+		return preparation.Body, false, nil
+	}
+	unlock := preparation.LockCompaction()
+	defer unlock()
+	if err := preparation.RefreshCheckpoint(); err != nil {
+		return nil, false, fmt.Errorf("codex executor: refresh Claude Code context checkpoint: %w", err)
+	}
+	if err := measureCodexClaudeContext(preparation, baseModel); err != nil {
+		return nil, false, err
+	}
+	if !preparation.NeedsCompaction || preparation.CompactionAttempted {
+		return preparation.Body, false, nil
+	}
+	beforeTokens := preparation.InputTokens
+	var body []byte
+	var err error
+
+	method := "remote"
+	var compactErr error
+	semanticOrRemoteInstalled := false
+	if preparation.InputTokens < preparation.Profile.EffectiveWindow {
+		var compactResponse []byte
+		compactResponse, compactErr = e.requestCodexClaudeCompaction(
+			ctx,
+			auth,
+			req,
+			opts,
+			from,
+			baseModel,
+			baseURL,
+			apiKey,
+			originalPayloadSource,
+			preparation,
+		)
+		if compactErr == nil {
+			body, compactErr = preparation.InstallRemoteCompaction(compactResponse)
+			semanticOrRemoteInstalled = compactErr == nil
+		}
+	} else {
+		compactErr = fmt.Errorf("active context estimate %d already exceeds effective window %d", preparation.InputTokens, preparation.Profile.EffectiveWindow)
+	}
+	if compactErr != nil {
+		remoteErr := compactErr
+		method = "semantic"
+		var summary string
+		summary, compactErr = e.requestCodexClaudeSemanticCompaction(
+			ctx,
+			auth,
+			req,
+			opts,
+			from,
+			baseModel,
+			baseURL,
+			apiKey,
+			originalPayloadSource,
+			preparation,
+		)
+		if compactErr == nil {
+			body, compactErr = preparation.InstallSemanticCompaction(summary)
+			semanticOrRemoteInstalled = compactErr == nil
+		}
+		if compactErr != nil {
+			method = "local emergency"
+			log.WithError(remoteErr).WithField("semantic_error", compactErr.Error()).Warn("codex executor: model compaction unavailable; installing deterministic checkpoint")
+			body, err = preparation.InstallLocalCompaction(remoteErr.Error())
+			if err != nil {
+				return nil, false, fmt.Errorf("codex executor: local context compaction failed: %w", err)
+			}
+		}
+	}
+	if err = measureCodexClaudeContext(preparation, baseModel); err != nil {
+		return nil, false, err
+	}
+	body = preparation.Body
+	if semanticOrRemoteInstalled && preparation.NeedsCompaction {
+		// A malformed or unexpectedly large compact response must not be allowed
+		// to enter a permanent 400 loop.
+		method = "local post-compact"
+		body, err = preparation.InstallLocalCompaction("remote checkpoint remained above the proactive threshold")
+		if err != nil {
+			return nil, false, fmt.Errorf("codex executor: post-compact reduction failed: %w", err)
+		}
+		if err = measureCodexClaudeContext(preparation, baseModel); err != nil {
+			return nil, false, err
+		}
+		body = preparation.Body
+	}
+	if err = preparation.PersistMeasuredTokensAfter(); err != nil {
+		return nil, false, fmt.Errorf("codex executor: persist measured checkpoint metadata: %w", err)
+	}
+	if err = internalcache.DeleteCodexReasoningReplayItemRequired(ctx, baseModel, preparation.Scope); err != nil {
+		return nil, false, fmt.Errorf("codex executor: retire pre-checkpoint reasoning: %w", err)
+	}
+	log.Infof(
+		"codex executor: Claude Code context checkpoint installed method=%s scope=%s before=%d after=%d threshold=%d",
+		method,
+		preparation.Scope,
+		beforeTokens,
+		preparation.InputTokens,
+		preparation.Profile.AutoCompactTokens,
+	)
+	return body, true, nil
+}
+
+func measureCodexClaudeContext(preparation *helps.ClaudeCodeContextPreparation, model string) error {
+	if preparation == nil || !preparation.Enabled {
+		return nil
+	}
+	total, fixed, err := countCodexContextTokens(model, preparation.Body)
+	if err != nil {
+		return fmt.Errorf("codex executor: measure Claude Code context: %w", err)
+	}
+	return preparation.SetMeasuredTokenCounts(total, fixed)
+}
+
+func (e *CodexExecutor) requestCodexClaudeCompaction(
+	ctx context.Context,
+	auth *cliproxyauth.Auth,
+	req cliproxyexecutor.Request,
+	opts cliproxyexecutor.Options,
+	from sdktranslator.Format,
+	baseModel string,
+	baseURL string,
+	apiKey string,
+	originalPayloadSource []byte,
+	preparation *helps.ClaudeCodeContextPreparation,
+) ([]byte, error) {
+	compactBody, err := preparation.CompactPayload()
+	if err != nil {
+		return nil, err
+	}
+	url := strings.TrimSuffix(baseURL, "/") + "/responses/compact"
+	httpReq, upstreamBody, identityState, err := e.cacheHelper(ctx, from, url, auth, req, originalPayloadSource, compactBody, opts.Headers)
+	if err != nil {
+		return nil, err
+	}
+	applyCodexHeaders(httpReq, auth, apiKey, true, e.cfg)
+	applyModelHeaderOverrides(httpReq.Header, baseModel)
+	applyCodexIdentityConfuseHeaders(httpReq.Header, &identityState)
+	helpRequest := helps.UpstreamRequestLog{URL: url, Method: http.MethodPost, Headers: httpReq.Header.Clone(), Body: upstreamBody, Provider: e.Identifier()}
+	if auth != nil {
+		helpRequest.AuthID = auth.ID
+		helpRequest.AuthLabel = auth.Label
+		helpRequest.AuthType, helpRequest.AuthValue = auth.AccountInfo()
+	}
+	helps.RecordAPIRequest(ctx, e.cfg, helpRequest)
+
+	httpClient := helps.NewUtlsHTTPClient(ctx, e.cfg, auth, 0)
+	httpResp, err := doCodexRequestWithTransportRetry(ctx, e.cfg, httpClient, httpReq)
+	if err != nil {
+		helps.RecordAPIResponseError(ctx, e.cfg, err)
+		return nil, err
+	}
+	defer func() {
+		if closeErr := httpResp.Body.Close(); closeErr != nil {
+			log.Errorf("codex executor: close compact response body error: %v", closeErr)
+		}
+	}()
+	helps.RecordAPIResponseMetadata(ctx, e.cfg, httpResp.StatusCode, httpResp.Header.Clone())
+	data, err := io.ReadAll(io.LimitReader(httpResp.Body, 8*1024*1024))
+	if err != nil {
+		return nil, err
+	}
+	data = applyCodexIdentityConfuseResponsePayload(data, identityState)
+	if httpResp.StatusCode < 200 || httpResp.StatusCode >= 300 {
+		return nil, newCodexStatusErr(httpResp.StatusCode, data)
+	}
+	return data, nil
+}
+
+func (e *CodexExecutor) requestCodexClaudeSemanticCompaction(
+	ctx context.Context,
+	auth *cliproxyauth.Auth,
+	req cliproxyexecutor.Request,
+	opts cliproxyexecutor.Options,
+	from sdktranslator.Format,
+	baseModel string,
+	baseURL string,
+	apiKey string,
+	originalPayloadSource []byte,
+	preparation *helps.ClaudeCodeContextPreparation,
+) (string, error) {
+	semanticBody, err := preparation.SemanticCompactPayload()
+	if err != nil {
+		return "", err
+	}
+	url := strings.TrimSuffix(baseURL, "/") + "/responses"
+	httpReq, upstreamBody, identityState, err := e.cacheHelper(ctx, from, url, auth, req, originalPayloadSource, semanticBody, opts.Headers)
+	if err != nil {
+		return "", err
+	}
+	applyCodexHeaders(httpReq, auth, apiKey, true, e.cfg)
+	applyModelHeaderOverrides(httpReq.Header, baseModel)
+	applyCodexIdentityConfuseHeaders(httpReq.Header, &identityState)
+	helpRequest := helps.UpstreamRequestLog{URL: url, Method: http.MethodPost, Headers: httpReq.Header.Clone(), Body: upstreamBody, Provider: e.Identifier()}
+	if auth != nil {
+		helpRequest.AuthID = auth.ID
+		helpRequest.AuthLabel = auth.Label
+		helpRequest.AuthType, helpRequest.AuthValue = auth.AccountInfo()
+	}
+	helps.RecordAPIRequest(ctx, e.cfg, helpRequest)
+	httpClient := helps.NewUtlsHTTPClient(ctx, e.cfg, auth, 0)
+	httpResp, err := doCodexRequestWithTransportRetry(ctx, e.cfg, httpClient, httpReq)
+	if err != nil {
+		helps.RecordAPIResponseError(ctx, e.cfg, err)
+		return "", err
+	}
+	defer func() {
+		if closeErr := httpResp.Body.Close(); closeErr != nil {
+			log.Errorf("codex executor: close semantic compact response body error: %v", closeErr)
+		}
+	}()
+	helps.RecordAPIResponseMetadata(ctx, e.cfg, httpResp.StatusCode, httpResp.Header.Clone())
+	data, err := io.ReadAll(io.LimitReader(httpResp.Body, 8*1024*1024))
+	if err != nil {
+		return "", err
+	}
+	data = applyCodexIdentityConfuseResponsePayload(data, identityState)
+	if httpResp.StatusCode < 200 || httpResp.StatusCode >= 300 {
+		return "", newCodexStatusErr(httpResp.StatusCode, data)
+	}
+	summary := extractCodexSemanticSummary(data)
+	if strings.TrimSpace(summary) == "" {
+		return "", errors.New("codex executor: semantic compact response contained no output text")
+	}
+	return summary, nil
+}
+
+func extractCodexSemanticSummary(data []byte) string {
+	if root := gjson.ParseBytes(data); root.IsObject() {
+		if text := codexResponseOutputText(root); text != "" {
+			return text
+		}
+	}
+	outputItemsByIndex := make(map[int64][]byte)
+	var outputItemsFallback [][]byte
+	var deltas strings.Builder
+	for _, line := range strings.Split(string(data), "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(line, "data:") {
+			continue
+		}
+		eventData := []byte(strings.TrimSpace(strings.TrimPrefix(line, "data:")))
+		eventType := gjson.GetBytes(eventData, "type").String()
+		switch eventType {
+		case "response.output_text.delta":
+			deltas.WriteString(gjson.GetBytes(eventData, "delta").String())
+		case "response.output_item.done":
+			collectCodexOutputItemDone(eventData, outputItemsByIndex, &outputItemsFallback)
+		case "response.completed":
+			patched := patchCodexCompletedOutput(eventData, outputItemsByIndex, outputItemsFallback)
+			if text := codexResponseOutputText(gjson.ParseBytes(patched)); text != "" {
+				return text
+			}
+		}
+	}
+	return deltas.String()
+}
+
+func codexResponseOutputText(root gjson.Result) string {
+	output := root.Get("output")
+	if responseOutput := root.Get("response.output"); responseOutput.IsArray() {
+		output = responseOutput
+	}
+	var texts []string
+	for _, item := range output.Array() {
+		if item.Get("type").String() != "message" {
+			continue
+		}
+		for _, part := range item.Get("content").Array() {
+			if part.Get("type").String() == "output_text" {
+				if text := strings.TrimSpace(part.Get("text").String()); text != "" {
+					texts = append(texts, text)
+				}
+			}
+		}
+	}
+	return strings.Join(texts, "\n")
+}
+
+// recoverCodexClaudeContext installs an emergency local checkpoint after an
+// unpredicted upstream context rejection. It is intentionally bounded to one
+// retry by each caller.
+func recoverCodexClaudeContext(ctx context.Context, preparation *helps.ClaudeCodeContextPreparation, model string, reason error) ([]byte, error) {
+	if preparation == nil || !preparation.Enabled {
+		return nil, reason
+	}
+	if preparation.NoFurtherReduction {
+		return nil, fmt.Errorf("claudex context: an emergency checkpoint already reduced this exact raw request as far as possible; the live turn or fixed prompt still exceeds the upstream limit: %w", reason)
+	}
+	body, err := preparation.InstallLocalCompaction("upstream context rejection: " + reason.Error())
+	if err != nil {
+		return nil, err
+	}
+	if err = internalcache.DeleteCodexReasoningReplayItemRequired(ctx, model, preparation.Scope); err != nil {
+		return nil, err
+	}
+	return body, nil
+}
+
+func codexErrorIsContextLength(err error) bool {
+	if err == nil {
+		return false
+	}
+	var upstream statusErr
+	if errors.As(err, &upstream) {
+		return codexTerminalErrorIsContextLength([]byte(upstream.msg))
+	}
+	return codexTerminalErrorIsContextLength([]byte(err.Error()))
+}
