+// PrepareClaudeCodeContext applies a matching persisted checkpoint and decides
+// whether the active model-visible history should be compacted before sampling.
+func PrepareClaudeCodeContext(ctx context.Context, cfg *config.Config, model string, claudePayload []byte, headers http.Header, body []byte) (*ClaudeCodeContextPreparation, error) {
+	if cfg == nil || !cfg.Codex.ClaudeCodeContext.Enabled {
+		return nil, nil
+	}
+	scope, ok := ClaudeCodeExecutionScope(ctx, claudePayload, headers)
+	if !ok {
+		return nil, nil
+	}
+	input := gjson.GetBytes(body, "input")
+	if !input.IsArray() {
+		return nil, nil
+	}
+
+	settings := cfg.Codex.ClaudeCodeContext
+	stateDir := expandClaudeContextPath(settings.StateDir)
+	if stateDir == "" {
+		stateDir = filepath.Join(claudeContextHomeDir(), ".config", "gpt-in-claude-code", "context")
+	}
+	profile := resolveClaudeCodeContextProfile(settings, model)
+	fixedTokens := estimateClaudeFixedPrefixTokens(body)
+	if fixedTokens >= profile.EffectiveWindow {
+		return nil, fmt.Errorf("claudex context: fixed instructions and tool schemas require about %d tokens, exceeding the %d-token effective model window", fixedTokens, profile.EffectiveWindow)
+	}
+
+	rawItems := rawMessages(input.Array())
+	checkpointPath := claudeContextCheckpointPath(stateDir, scope, model)
+	activeItems := cloneRawMessages(rawItems)
+	generation := 0
+	compactionAttempted := false
+	noFurtherReduction := false
+
+	stateMu := claudeContextMutex(&claudeContextStateLocks, checkpointPath)
+	stateMu.Lock()
+	checkpoint, errCheckpoint := readClaudeContextCheckpoint(checkpointPath)
+	if errCheckpoint != nil && !errors.Is(errCheckpoint, os.ErrNotExist) {
+		_ = quarantineClaudeContextCheckpoint(checkpointPath)
+		checkpoint = nil
+		errCheckpoint = nil
+	}
+	stateMu.Unlock()
+	if checkpoint != nil && checkpointMatches(checkpoint, scope, model, rawItems) {
+		activeItems = append(cloneRawMessages(checkpoint.Replacement), cloneRawMessages(rawItems[checkpoint.RawPrefixItems:])...)
+		generation = checkpoint.Generation
+		// A local fallback may be unable to shrink one oversized live turn below
+		// the proactive threshold. Do not wrap the same raw prefix in another
+		// synthetic checkpoint on every retry or `continue` request.
+		compactionAttempted = checkpoint.RawPrefixItems == len(rawItems) &&
+			(checkpoint.NoFurtherReduction || strings.HasPrefix(checkpoint.Method, "local"))
+		noFurtherReduction = compactionAttempted
+	}
+
+	activeBody, err := replaceResponsesInput(body, activeItems)
+	if err != nil {
+		return nil, fmt.Errorf("claudex context: install checkpoint: %w", err)
+	}
+	inputTokens := EstimateCodexModelVisibleTokens(activeBody)
+	maxSummaryChars := settings.LocalSummaryMaxChars
+	if maxSummaryChars <= 0 {
+		maxSummaryChars = defaultClaudeLocalSummaryChars
+	}
+	archiveMaxFiles := settings.ArchiveMaxFiles
+	if archiveMaxFiles <= 0 {
+		archiveMaxFiles = defaultClaudeArchiveMaxFiles
+	}
+	archiveMaxBytes := settings.ArchiveMaxBytes
+	if archiveMaxBytes <= 0 {
+		archiveMaxBytes = defaultClaudeArchiveMaxBytes
+	}
+	archiveMaxAgeDays := settings.ArchiveMaxAgeDays
+	if archiveMaxAgeDays <= 0 {
+		archiveMaxAgeDays = defaultClaudeArchiveMaxAgeDays
+	}
+	return &ClaudeCodeContextPreparation{
+		Enabled:             true,
+		Body:                activeBody,
+		NeedsCompaction:     inputTokens >= profile.AutoCompactTokens,
+		CompactionAttempted: compactionAttempted,
+		NoFurtherReduction:  noFurtherReduction,
+		InputTokens:         inputTokens,
+		FixedPrefixTokens:   fixedTokens,
+		Profile:             profile,
+		Scope:               scope,
+		Model:               model,
+		stateDir:            stateDir,
+		checkpointPath:      checkpointPath,
+		rawItems:            rawItems,
+		activeItems:         activeItems,
+		generation:          generation,
+		maxSummaryChars:     maxSummaryChars,
+		archiveRawInput:     settings.ArchiveRawInput,
+		archiveMaxFiles:     archiveMaxFiles,
+		archiveMaxBytes:     archiveMaxBytes,
+		archiveMaxAge:       time.Duration(archiveMaxAgeDays) * 24 * time.Hour,
+	}, nil
+}
+
+func claudeContextMutex(registry *sync.Map, key string) *sync.Mutex {
+	value, _ := registry.LoadOrStore(key, &sync.Mutex{})
+	return value.(*sync.Mutex)
+}
+
+// LockCompaction serializes compaction for one session/agent/model scope while
+// allowing unrelated Claude Code sessions and background agents to proceed.
+func (p *ClaudeCodeContextPreparation) LockCompaction() func() {
+	if p == nil || p.checkpointPath == "" {
+		return func() {}
+	}
+	mu := claudeContextMutex(&claudeContextWorkflowLocks, p.checkpointPath)
+	mu.Lock()
+	return mu.Unlock
+}
+
+// RefreshCheckpoint observes a checkpoint installed by an earlier concurrent
+// request after the caller acquired LockCompaction. This is the singleflight
+// recheck that prevents duplicate remote compaction and stale checkpoint writes.
+func (p *ClaudeCodeContextPreparation) RefreshCheckpoint() error {
+	if p == nil || !p.Enabled {
+		return nil
+	}
+	stateMu := claudeContextMutex(&claudeContextStateLocks, p.checkpointPath)
+	stateMu.Lock()
+	checkpoint, err := readClaudeContextCheckpoint(p.checkpointPath)
+	stateMu.Unlock()
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if checkpoint.Generation <= p.generation || !checkpointMatches(checkpoint, p.Scope, p.Model, p.rawItems) {
+		return nil
+	}
+	p.activeItems = append(cloneRawMessages(checkpoint.Replacement), cloneRawMessages(p.rawItems[checkpoint.RawPrefixItems:])...)
+	p.generation = checkpoint.Generation
+	p.CompactionAttempted = checkpoint.RawPrefixItems == len(p.rawItems) &&
+		(checkpoint.NoFurtherReduction || strings.HasPrefix(checkpoint.Method, "local"))
+	p.NoFurtherReduction = p.CompactionAttempted
+	updated, err := replaceResponsesInput(p.Body, p.activeItems)
+	if err != nil {
+		return err
+	}
+	p.Body = updated
+	p.InputTokens = EstimateCodexModelVisibleTokens(updated)
+	p.NeedsCompaction = p.InputTokens >= p.Profile.AutoCompactTokens
+	return nil
+}
+
+// SetMeasuredTokenCounts installs the executor's tokenizer-backed count. The
+// helpers package keeps a fast byte estimate as a fallback, while the executor
+// can use the model tokenizer without introducing a package dependency cycle.
+func (p *ClaudeCodeContextPreparation) SetMeasuredTokenCounts(total, fixed int64) error {
+	if p == nil || !p.Enabled {
+		return nil
+	}
+	if total > 0 {
+		p.InputTokens = total
+	}
+	if fixed > 0 {
+		p.FixedPrefixTokens = fixed
+	}
+	if p.FixedPrefixTokens >= p.Profile.EffectiveWindow {
+		return fmt.Errorf("claudex context: fixed instructions and tool schemas require about %d tokens, exceeding the %d-token effective model window", p.FixedPrefixTokens, p.Profile.EffectiveWindow)
+	}
+	if p.NoFurtherReduction && p.InputTokens >= p.Profile.EffectiveWindow {
+		return fmt.Errorf("claudex context: the exact live turn and fixed prompt still require about %d tokens after emergency reduction; effective model limit is %d", p.InputTokens, p.Profile.EffectiveWindow)
+	}
+	p.NeedsCompaction = p.InputTokens >= p.Profile.AutoCompactTokens
+	return nil
+}
+
+// PersistMeasuredTokensAfter replaces the checkpoint's fast post-install
+// estimate with the executor's tokenizer-backed count. It is called only after
+// a new checkpoint has been installed, so later status output remains useful
+// without rewriting state on every ordinary turn.
+func (p *ClaudeCodeContextPreparation) PersistMeasuredTokensAfter() error {
+	if p == nil || !p.Enabled || p.generation <= 0 {
+		return nil
+	}
+	stateMu := claudeContextMutex(&claudeContextStateLocks, p.checkpointPath)
+	stateMu.Lock()
+	defer stateMu.Unlock()
+	checkpoint, err := readClaudeContextCheckpoint(p.checkpointPath)
+	if err != nil {
+		return err
+	}
+	if checkpoint.Generation != p.generation || checkpoint.Scope != p.Scope || checkpoint.Model != p.Model {
+		return errors.New("claudex context: checkpoint changed before measured token metadata could be persisted")
+	}
+	checkpoint.InputTokensAfter = p.InputTokens
+	return writeClaudeContextCheckpoint(p.checkpointPath, checkpoint)
+}
