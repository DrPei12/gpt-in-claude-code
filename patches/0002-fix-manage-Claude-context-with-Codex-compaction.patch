+func TestCountCodexContextTokensDoesNotUndercountLargeCJK(t *testing.T) {
+	for _, content := range []any{
+		strings.Repeat("你", 100_000),
+		[]any{map[string]any{"type": "input_text", "text": strings.Repeat("你", 100_000)}},
+	} {
+		body, err := json.Marshal(map[string]any{
+			"model": "gpt-5.6-sol",
+			"input": []any{map[string]any{"type": "message", "role": "user", "content": content}},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		total, _, err := countCodexContextTokens("gpt-5.6-sol", body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if total < 90_000 {
+			t.Fatalf("100k CJK characters counted as %d tokens; byte/4 undercount has returned", total)
+		}
+	}
+}
+
+func TestCountCodexContextTokensDoesNotUseSerializedByteEstimateAsTruth(t *testing.T) {
+	body, err := json.Marshal(map[string]any{
+		"model": "gpt-5.6-sol",
+		"input": []any{map[string]any{
+			"type": "message", "role": "user", "content": strings.Repeat("x", 200_000),
+		}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	total, _, err := countCodexContextTokens("gpt-5.6-sol", body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if total >= 40_000 {
+		t.Fatalf("highly compressible ASCII counted as %d tokens; serialized byte/4 estimate is still overriding the tokenizer", total)
+	}
+}
+
+func TestCountCodexContextTokensCountsReasoningCiphertextButNormalizesImages(t *testing.T) {
+	ciphertext := strings.Repeat("Ab9/", 20_000)
+	body, err := json.Marshal(map[string]any{
+		"model": "gpt-5.6-sol",
+		"input": []any{
+			map[string]any{"type": "reasoning", "summary": []any{}, "encrypted_content": ciphertext},
+			map[string]any{"type": "message", "role": "user", "content": []any{
