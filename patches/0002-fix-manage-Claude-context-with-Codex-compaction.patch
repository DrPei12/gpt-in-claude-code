+package config
+
+import "testing"
+
+func TestParseConfigBytesClaudeCodeContext(t *testing.T) {
+	cfg, err := ParseConfigBytes([]byte(`
+codex:
+  claude-code-context:
+    enabled: true
+    state-dir: ~/.config/gpt-in-claude-code/context
+    model-catalog-path: ~/.codex/models_cache.json
+    context-window: 272000
+    effective-context-window-percent: 95
+    auto-compact-percent: 90
+    post-compact-percent: 60
+    local-summary-max-chars: 48000
+    archive-raw-input: true
+    archive-max-files: 7
+    archive-max-bytes: 123456
+    archive-max-age-days: 11
+`))
+	if err != nil {
+		t.Fatalf("ParseConfigBytes() error = %v", err)
+	}
+	got := cfg.Codex.ClaudeCodeContext
+	if !got.Enabled || got.StateDir != "~/.config/gpt-in-claude-code/context" || got.ContextWindow != 272_000 {
+		t.Fatalf("core context config = %+v", got)
+	}
+	if got.EffectiveContextWindowPercent != 95 || got.AutoCompactPercent != 90 || got.PostCompactPercent != 60 || got.LocalSummaryMaxChars != 48_000 {
+		t.Fatalf("budget context config = %+v", got)
+	}
+	if !got.ArchiveRawInput || got.ArchiveMaxFiles != 7 || got.ArchiveMaxBytes != 123_456 || got.ArchiveMaxAgeDays != 11 {
+		t.Fatalf("archive context config = %+v", got)
+	}
+}
