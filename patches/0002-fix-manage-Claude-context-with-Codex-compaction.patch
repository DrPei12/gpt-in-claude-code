+// CompactPayload returns the canonical body accepted by /responses/compact.
+func (p *ClaudeCodeContextPreparation) CompactPayload() ([]byte, error) {
+	if p == nil || !p.Enabled {
+		return nil, errors.New("claudex context: preparation is disabled")
+	}
+	root := gjson.ParseBytes(p.Body)
+	out := []byte(`{"model":"","input":[],"instructions":"","parallel_tool_calls":false}`)
+	var err error
+	out, err = sjson.SetBytes(out, "model", p.Model)
+	if err != nil {
+		return nil, err
+	}
+	out, err = sjson.SetRawBytes(out, "input", []byte(rawMessagesJSON(p.activeItems)))
+	if err != nil {
+		return nil, err
+	}
+	if instructions := root.Get("instructions"); instructions.Exists() && instructions.Type == gjson.String {
+		out, _ = sjson.SetBytes(out, "instructions", instructions.String())
+	}
+	if tools := root.Get("tools"); tools.IsArray() {
+		out, _ = sjson.SetRawBytes(out, "tools", []byte(tools.Raw))
+	}
+	if value := root.Get("parallel_tool_calls"); value.Exists() {
+		out, _ = sjson.SetBytes(out, "parallel_tool_calls", value.Bool())
+	}
+	for _, path := range []string{"reasoning", "service_tier", "prompt_cache_key", "text"} {
+		if value := root.Get(path); value.Exists() && value.Type != gjson.Null {
+			out, _ = sjson.SetRawBytes(out, path, []byte(value.Raw))
+		}
+	}
+	return out, nil
+}
+
+const claudeSemanticCompactInstructions = `You compress coding-agent history for a continuation request. Return only a concise factual checkpoint. Preserve: the user's goal, explicit constraints, decisions, completed work, exact file paths and commands, test evidence, failures, and the next unfinished action. Do not answer the user's task, invent facts, or repeat raw logs. Use these headings: Goal, Constraints, Completed, Files and commands, Evidence, Remaining.`
+
+// SemanticCompactPayload builds a normal Responses request used when the
+// dedicated compact endpoint is unavailable. Only history before the current
+// user turn is summarized; the exact live turn is retained by the installer.
+func (p *ClaudeCodeContextPreparation) SemanticCompactPayload() ([]byte, error) {
+	if p == nil || !p.Enabled {
+		return nil, errors.New("claudex context: preparation is disabled")
+	}
+	userIndex := lastUserMessageIndex(p.activeItems)
+	if userIndex <= 0 {
+		return nil, errors.New("claudex context: no historical prefix is available for semantic compaction")
+	}
+	prefix := normalizeToolPairs(truncateLocalTail(p.activeItems[:userIndex]))
+	if len(prefix) == 0 {
+		return nil, errors.New("claudex context: semantic compact prefix is empty")
+	}
+	request := []byte(`{"model":"","instructions":"","input":[],"parallel_tool_calls":false,"reasoning":{"effort":"low","summary":"auto"},"stream":true,"store":false,"include":["reasoning.encrypted_content"]}`)
+	var err error
+	request, err = sjson.SetBytes(request, "model", p.Model)
+	if err != nil {
+		return nil, err
+	}
+	request, err = sjson.SetBytes(request, "instructions", claudeSemanticCompactInstructions)
+	if err != nil {
+		return nil, err
+	}
+	request, err = sjson.SetRawBytes(request, "input", []byte(rawMessagesJSON(prefix)))
+	if err != nil {
+		return nil, err
+	}
+	request, err = sjson.SetRawBytes(request, "input.-1", []byte(`{"type":"message","role":"user","content":[{"type":"input_text","text":"Create the continuation checkpoint now."}]}`))
+	if err != nil {
+		return nil, err
+	}
+	return request, nil
+}
+
+// ObserveBody updates the active model-visible request after transient state
+// such as encrypted reasoning replay has been inserted. The raw transcript
+// fingerprint remains unchanged, so a resulting checkpoint still reconciles
+// against Claude Code's authoritative history on the next request.
+func (p *ClaudeCodeContextPreparation) ObserveBody(body []byte) error {
+	if p == nil || !p.Enabled {
+		return nil
+	}
+	input := gjson.GetBytes(body, "input")
+	if !input.IsArray() {
+		return errors.New("claudex context: observed body has no input array")
+	}
+	previousNeedsCompaction := p.NeedsCompaction
+	p.Body = bytes.Clone(body)
+	p.activeItems = rawMessages(input.Array())
+	p.InputTokens = EstimateCodexModelVisibleTokens(body)
+	p.NeedsCompaction = p.InputTokens >= p.Profile.AutoCompactTokens
+	// Reasoning replay and tool output can grow a previously compacted request
+	// past the proactive boundary again. Re-arm remote/semantic compaction for
+	// that new crossing, while keeping an emergency local fallback one-shot.
+	if p.NeedsCompaction && !previousNeedsCompaction && !p.NoFurtherReduction {
+		p.CompactionAttempted = false
+	}
+	return nil
+}
+
+// InstallRemoteCompaction validates, persists, and activates a compact endpoint
+// response. The checkpoint covers the complete raw input in this request.
+func (p *ClaudeCodeContextPreparation) InstallRemoteCompaction(response []byte) ([]byte, error) {
+	output := gjson.GetBytes(response, "output")
+	if !output.IsArray() || len(output.Array()) == 0 {
+		return nil, errors.New("claudex context: compact response has no replacement output")
+	}
+	replacement := filterRemoteCompactionOutput(rawMessages(output.Array()))
+	if len(replacement) == 0 {
+		return nil, errors.New("claudex context: compact response replacement is empty")
+	}
+	return p.installReplacement(replacement, "remote", false)
+}
+
+// InstallLocalCompaction is the non-recursive safety net used when the remote
+// compact endpoint is unavailable or the upstream reports a context overflow.
+func (p *ClaudeCodeContextPreparation) InstallLocalCompaction(reason string) ([]byte, error) {
+	if p == nil || !p.Enabled {
+		return nil, errors.New("claudex context: preparation is disabled")
+	}
+	replacement := buildLocalCompactionReplacement(p.activeItems, p.maxSummaryChars, reason)
+	if len(replacement) == 0 {
+		return nil, errors.New("claudex context: local replacement is empty")
+	}
+	updated, err := replaceResponsesInput(p.Body, replacement)
+	if err != nil {
+		return nil, err
+	}
+	target := p.Profile.PostCompactTokens
+	if minimum := p.FixedPrefixTokens + 8_192; target < minimum {
+		target = minimum
+	}
+	if EstimateCodexModelVisibleTokens(updated) > target {
+		replacement = buildAggressiveLocalCompactionReplacement(p.activeItems, minInt(p.maxSummaryChars, 16_000), reason)
+		updated, err = replaceResponsesInput(p.Body, replacement)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if tokens := EstimateCodexModelVisibleTokens(updated); tokens >= p.Profile.EffectiveWindow {
+		return nil, fmt.Errorf("claudex context: the live user turn and fixed prefix still require about %d tokens after emergency reduction; effective model limit is %d", tokens, p.Profile.EffectiveWindow)
+	}
+	return p.installReplacement(replacement, "local", true)
+}
+
+// InstallSemanticCompaction persists a model-generated fallback summary while
+// retaining the current user turn and its complete, pair-normalized tool tail.
+func (p *ClaudeCodeContextPreparation) InstallSemanticCompaction(summary string) ([]byte, error) {
+	if p == nil || !p.Enabled {
+		return nil, errors.New("claudex context: preparation is disabled")
+	}
+	if p.maxSummaryChars > 0 && len(summary) > p.maxSummaryChars {
+		summary = truncateUTF8(summary, p.maxSummaryChars)
+	}
+	replacement := buildSemanticCompactionReplacement(p.activeItems, summary)
+	if len(replacement) == 0 {
+		return nil, errors.New("claudex context: semantic compact summary is empty")
+	}
+	return p.installReplacement(replacement, "semantic", false)
+}
+
+func (p *ClaudeCodeContextPreparation) installReplacement(replacement []json.RawMessage, method string, noFurtherReduction bool) ([]byte, error) {
+	updated, err := replaceResponsesInput(p.Body, replacement)
+	if err != nil {
+		return nil, err
+	}
+	afterTokens := EstimateCodexModelVisibleTokens(updated)
+	checkpoint := &claudeCodeContextCheckpoint{
+		Version:              claudeContextCheckpointVersion,
+		Scope:                p.Scope,
+		Model:                p.Model,
+		Generation:           p.generation + 1,
+		RawPrefixItems:       len(p.rawItems),
+		RawPrefixFingerprint: fingerprintRawMessages(p.rawItems),
+		Replacement:          cloneRawMessages(replacement),
+		Method:               method,
+		InputTokensBefore:    p.InputTokens,
+		InputTokensAfter:     afterTokens,
+		NoFurtherReduction:   noFurtherReduction,
+		CreatedAt:            time.Now().UTC(),
+	}
+
+	stateMu := claudeContextMutex(&claudeContextStateLocks, p.checkpointPath)
+	stateMu.Lock()
+	defer stateMu.Unlock()
+	if err = os.MkdirAll(p.stateDir, 0o700); err != nil {
+		return nil, fmt.Errorf("create state directory: %w", err)
+	}
+	if p.archiveRawInput {
+		if err = archiveClaudeContextInput(p.stateDir, checkpoint.Generation, p.Scope, p.Model, p.rawItems); err != nil {
+			return nil, fmt.Errorf("archive raw input: %w", err)
+		}
+		if err = pruneClaudeContextArchives(p.stateDir, p.archiveMaxFiles, p.archiveMaxBytes, p.archiveMaxAge); err != nil {
+			return nil, fmt.Errorf("prune raw input archives: %w", err)
+		}
+	}
+	if err = writeClaudeContextCheckpoint(p.checkpointPath, checkpoint); err != nil {
+		return nil, fmt.Errorf("write checkpoint: %w", err)
+	}
+	p.Body = updated
+	p.activeItems = cloneRawMessages(replacement)
+	p.generation = checkpoint.Generation
+	p.InputTokens = afterTokens
+	p.NeedsCompaction = afterTokens >= p.Profile.AutoCompactTokens
+	p.CompactionAttempted = true
+	p.NoFurtherReduction = noFurtherReduction
+	return updated, nil
+}
+
+// EstimateCodexModelVisibleTokens follows Codex's conservative serialized-byte
+// heuristic. It includes instructions, tool schemas, reasoning ciphertext, and
+// tool outputs, avoiding the under-count that caused the original overflow.
+func EstimateCodexModelVisibleTokens(body []byte) int64 {
+	root := gjson.ParseBytes(body)
+	var visibleBytes int64
+	if instructions := root.Get("instructions"); instructions.Type == gjson.String {
+		visibleBytes += int64(len(instructions.String()))
+	}
+	if input := root.Get("input"); input.IsArray() {
+		for _, item := range input.Array() {
+			visibleBytes += estimateResponseItemVisibleBytes(item)
+		}
+	}
+	for _, path := range []string{"tools", "text.format"} {
+		if value := root.Get(path); value.Exists() && value.Type != gjson.Null {
+			visibleBytes += int64(len(value.Raw))
+		}
+	}
+	if visibleBytes <= 0 {
+		return 0
+	}
+	return (visibleBytes + modelVisibleBytesPerToken - 1) / modelVisibleBytesPerToken
+}
+
+func estimateClaudeFixedPrefixTokens(body []byte) int64 {
+	root := gjson.ParseBytes(body)
+	var visibleBytes int64
+	if instructions := root.Get("instructions"); instructions.Type == gjson.String {
+		visibleBytes += int64(len(instructions.String()))
+	}
+	for _, path := range []string{"tools", "text.format"} {
+		if value := root.Get(path); value.Exists() && value.Type != gjson.Null {
+			visibleBytes += int64(len(value.Raw))
+		}
+	}
+	return (visibleBytes + modelVisibleBytesPerToken - 1) / modelVisibleBytesPerToken
+}
+
+func estimateResponseItemVisibleBytes(item gjson.Result) int64 {
+	// Inline images should be budgeted like Codex's normalized resized image,
+	// not by their base64 transport size.
+	if item.Get("type").String() == "message" {
+		var total int64 = 32
+		for _, part := range item.Get("content").Array() {
+			switch part.Get("type").String() {
+			case "input_image", "image_url":
+				total += 7_373
+			default:
+				total += int64(len(part.Raw))
+			}
+		}
+		if total > 32 {
+			return total
+		}
+	}
+	return int64(len(item.Raw))
+}
+
+func resolveClaudeCodeContextProfile(settings config.ClaudeCodeContextConfig, model string) ClaudeCodeContextProfile {
+	contextWindow := settings.ContextWindow
+	effectivePercent := settings.EffectiveContextWindowPercent
+	autoCompactTokens := int64(0)
+	matched := false
+	if settings.ModelCatalogPath != "" {
+		if profile, ok := readCodexModelProfile(expandClaudeContextPath(settings.ModelCatalogPath), model); ok {
+			if contextWindow <= 0 {
+				contextWindow = profile.ContextWindow
+			}
+			if effectivePercent <= 0 {
+				effectivePercent = profile.EffectivePercent
+			}
+			if settings.AutoCompactPercent <= 0 {
+				autoCompactTokens = profile.AutoCompactTokens
+			}
+			matched = true
+		}
+	}
+	if contextWindow <= 0 {
+		if strings.EqualFold(strings.TrimSpace(model), "gpt-5.6-sol") {
+			contextWindow = 272_000
+		} else {
+			contextWindow = defaultClaudeContextWindow
+		}
+	}
+	if effectivePercent <= 0 || effectivePercent > 100 {
+		effectivePercent = defaultClaudeEffectivePercent
+	}
+	effectiveWindow := contextWindow * int64(effectivePercent) / 100
+	if autoCompactTokens <= 0 {
+		autoPercent := settings.AutoCompactPercent
+		if autoPercent <= 0 || autoPercent >= effectivePercent {
+			autoPercent = defaultClaudeAutoCompactPercent
+			if autoPercent >= effectivePercent {
+				autoPercent = maxInt(1, effectivePercent-5)
+			}
+		}
+		autoCompactTokens = contextWindow * int64(autoPercent) / 100
+	}
+	maxAutoCompactTokens := contextWindow * int64(defaultClaudeAutoCompactPercent) / 100
+	if autoCompactTokens > maxAutoCompactTokens {
+		autoCompactTokens = maxAutoCompactTokens
+	}
+	if autoCompactTokens >= effectiveWindow {
+		autoCompactTokens = maxInt64(1, effectiveWindow-8_192)
+	}
+	postPercent := settings.PostCompactPercent
+	autoPercentEquivalent := int(autoCompactTokens * 100 / contextWindow)
+	if postPercent <= 0 || postPercent >= autoPercentEquivalent {
+		postPercent = defaultClaudePostCompactPercent
+		if postPercent >= autoPercentEquivalent {
+			postPercent = maxInt(1, autoPercentEquivalent*2/3)
+		}
+	}
+	return ClaudeCodeContextProfile{
+		ContextWindow:       contextWindow,
+		EffectiveWindow:     effectiveWindow,
+		AutoCompactTokens:   autoCompactTokens,
+		PostCompactTokens:   contextWindow * int64(postPercent) / 100,
+		ModelCatalogMatched: matched,
+	}
+}
+
+type codexModelProfile struct {
+	ContextWindow     int64
+	EffectivePercent  int
+	AutoCompactTokens int64
+}
+
+func readCodexModelProfile(path, model string) (codexModelProfile, bool) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return codexModelProfile{}, false
+	}
+	var catalog codexModelCatalog
+	if json.Unmarshal(data, &catalog) != nil {
+		return codexModelProfile{}, false
+	}
+	for _, candidate := range catalog.Models {
+		if !strings.EqualFold(strings.TrimSpace(candidate.Slug), strings.TrimSpace(model)) {
+			continue
+		}
+		window := candidate.ContextWindow
+		if window <= 0 {
+			window = candidate.MaxContextWindow
+		}
+		if window <= 0 {
+			return codexModelProfile{}, false
+		}
+		return codexModelProfile{
+			ContextWindow:     window,
+			EffectivePercent:  candidate.EffectiveContextWindowPercent,
+			AutoCompactTokens: candidate.AutoCompactTokenLimit,
+		}, true
+	}
+	return codexModelProfile{}, false
+}
+
+func checkpointMatches(checkpoint *claudeCodeContextCheckpoint, scope, model string, rawItems []json.RawMessage) bool {
+	if checkpoint == nil || checkpoint.Version < 1 || checkpoint.Version > claudeContextCheckpointVersion || checkpoint.Scope != scope || checkpoint.Model != model {
+		return false
+	}
+	if checkpoint.RawPrefixItems <= 0 || checkpoint.RawPrefixItems > len(rawItems) || len(checkpoint.Replacement) == 0 {
+		return false
+	}
+	return checkpoint.RawPrefixFingerprint == fingerprintRawMessages(rawItems[:checkpoint.RawPrefixItems])
+}
+
+func readClaudeContextCheckpoint(path string) (*claudeCodeContextCheckpoint, error) {
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		data, err = os.ReadFile(path + ".previous")
+	}
+	if err != nil {
+		return nil, err
+	}
+	var checkpoint claudeCodeContextCheckpoint
+	if err = json.Unmarshal(data, &checkpoint); err != nil {
+		return nil, err
+	}
+	return &checkpoint, nil
+}
+
+func writeClaudeContextCheckpoint(path string, checkpoint *claudeCodeContextCheckpoint) error {
+	data, err := json.MarshalIndent(checkpoint, "", "  ")
+	if err != nil {
+		return err
+	}
+	temp, err := os.CreateTemp(filepath.Dir(path), ".checkpoint-*.tmp")
+	if err != nil {
+		return err
+	}
+	tempPath := temp.Name()
+	defer func() { _ = os.Remove(tempPath) }()
+	if err = temp.Chmod(0o600); err == nil {
+		_, err = temp.Write(data)
+	}
+	if closeErr := temp.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	backupPath := path + ".previous"
+	_ = os.Remove(backupPath)
+	if _, statErr := os.Stat(path); statErr == nil {
+		if err = os.Rename(path, backupPath); err != nil {
+			return err
+		}
+	}
+	if err = os.Rename(tempPath, path); err != nil {
+		_ = os.Rename(backupPath, path)
+		return err
+	}
+	_ = os.Remove(backupPath)
+	return nil
+}
+
+func quarantineClaudeContextCheckpoint(path string) error {
+	if _, err := os.Stat(path); err != nil {
+		return err
+	}
+	quarantinePath := path + ".corrupt-" + time.Now().UTC().Format("20060102T150405.000000000Z")
+	return os.Rename(path, quarantinePath)
+}
+
+func archiveClaudeContextInput(stateDir string, generation int, scope, model string, rawItems []json.RawMessage) error {
+	archiveDir := filepath.Join(stateDir, "archive")
+	if err := os.MkdirAll(archiveDir, 0o700); err != nil {
+		return err
+	}
+	identity := sha256.Sum256([]byte(scope + "\x00" + model))
+	name := fmt.Sprintf("%s-g%04d-%s.json.gz", hex.EncodeToString(identity[:8]), generation, time.Now().UTC().Format("20060102T150405.000000000Z"))
+	file, err := os.OpenFile(filepath.Join(archiveDir, name), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	gz := gzip.NewWriter(file)
+	_, writeErr := io.WriteString(gz, rawMessagesJSON(rawItems))
+	closeGzipErr := gz.Close()
+	closeFileErr := file.Close()
+	if writeErr != nil {
+		return writeErr
+	}
+	if closeGzipErr != nil {
+		return closeGzipErr
+	}
+	return closeFileErr
+}
+
+func pruneClaudeContextArchives(stateDir string, maxFiles int, maxBytes int64, maxAge time.Duration) error {
+	archiveDir := filepath.Join(stateDir, "archive")
+	entries, err := os.ReadDir(archiveDir)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	type archiveFile struct {
+		path    string
+		size    int64
+		modTime time.Time
+	}
+	files := make([]archiveFile, 0, len(entries))
+	cutoff := time.Time{}
+	if maxAge > 0 {
+		cutoff = time.Now().Add(-maxAge)
+	}
+	for _, entry := range entries {
+		if entry.IsDir() || !strings.HasSuffix(entry.Name(), ".json.gz") {
+			continue
+		}
+		info, infoErr := entry.Info()
+		if infoErr != nil {
+			return infoErr
+		}
+		path := filepath.Join(archiveDir, entry.Name())
+		if !cutoff.IsZero() && info.ModTime().Before(cutoff) {
+			if removeErr := os.Remove(path); removeErr != nil && !errors.Is(removeErr, os.ErrNotExist) {
+				return removeErr
+			}
+			continue
+		}
+		files = append(files, archiveFile{path: path, size: info.Size(), modTime: info.ModTime()})
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].modTime.After(files[j].modTime) })
+	var keptBytes int64
+	for index, file := range files {
+		keepByCount := maxFiles <= 0 || index < maxFiles
+		keepByBytes := maxBytes <= 0 || keptBytes+file.size <= maxBytes
+		if keepByCount && keepByBytes {
+			keptBytes += file.size
+			continue
+		}
+		if removeErr := os.Remove(file.path); removeErr != nil && !errors.Is(removeErr, os.ErrNotExist) {
+			return removeErr
+		}
+	}
+	return nil
+}
+
+func claudeContextCheckpointPath(stateDir, scope, model string) string {
+	hash := sha256.Sum256([]byte(scope + "\x00" + model))
+	return filepath.Join(stateDir, hex.EncodeToString(hash[:16])+".checkpoint.json")
+}
+
+func fingerprintRawMessages(items []json.RawMessage) string {
+	hash := sha256.New()
+	for _, item := range items {
+		_, _ = fmt.Fprintf(hash, "%d:", len(item))
+		_, _ = hash.Write(item)
+		_, _ = hash.Write([]byte{0})
+	}
+	return hex.EncodeToString(hash.Sum(nil))
+}
+
+func replaceResponsesInput(body []byte, items []json.RawMessage) ([]byte, error) {
+	return sjson.SetRawBytes(body, "input", []byte(rawMessagesJSON(items)))
+}
+
+func rawMessages(results []gjson.Result) []json.RawMessage {
+	items := make([]json.RawMessage, 0, len(results))
+	for _, result := range results {
+		items = append(items, json.RawMessage(bytes.Clone([]byte(result.Raw))))
+	}
+	return items
+}
+
+func cloneRawMessages(items []json.RawMessage) []json.RawMessage {
+	cloned := make([]json.RawMessage, 0, len(items))
+	for _, item := range items {
+		cloned = append(cloned, json.RawMessage(bytes.Clone(item)))
+	}
+	return cloned
+}
+
+func rawMessagesJSON(items []json.RawMessage) string {
+	parts := make([]string, 0, len(items))
+	for _, item := range items {
+		parts = append(parts, string(item))
+	}
+	return "[" + strings.Join(parts, ",") + "]"
+}
+
+func filterRemoteCompactionOutput(items []json.RawMessage) []json.RawMessage {
+	filtered := make([]json.RawMessage, 0, len(items))
+	for _, item := range items {
+		result := gjson.ParseBytes(item)
+		switch result.Get("type").String() {
+		case "compaction", "compaction_summary":
+			filtered = append(filtered, item)
+		case "message":
+			role := result.Get("role").String()
+			if role == "user" || role == "assistant" {
+				filtered = append(filtered, item)
+			}
+		}
+	}
+	return filtered
+}
+
+func buildLocalCompactionReplacement(items []json.RawMessage, maxSummaryChars int, reason string) []json.RawMessage {
+	return buildBoundedLocalCompactionReplacement(items, maxSummaryChars, reason, 24, localToolOutputMaxChars, false)
+}
+
+func lastUserMessageIndex(items []json.RawMessage) int {
+	for i := len(items) - 1; i >= 0; i-- {
+		item := gjson.ParseBytes(items[i])
+		if item.Get("type").String() == "message" && item.Get("role").String() == "user" {
+			return i
+		}
+	}
+	return -1
+}
+
+func truncateLocalTail(items []json.RawMessage) []json.RawMessage {
+	return truncateLocalTailWithLimit(items, localToolOutputMaxChars)
+}
+
+func truncateLocalTailWithLimit(items []json.RawMessage, toolOutputMaxChars int) []json.RawMessage {
+	out := cloneRawMessages(items)
+	for i, raw := range out {
+		item := gjson.ParseBytes(raw)
+		switch item.Get("type").String() {
+		case "function_call_output", "custom_tool_call_output":
+			output := item.Get("output")
+			if output.Type == gjson.String && len(output.String()) > toolOutputMaxChars {
+				trimmed := truncateUTF8(output.String(), toolOutputMaxChars) + "\n[Claudex omitted the remainder of this tool output from model-visible context.]"
+				updated, err := sjson.SetBytes(raw, "output", trimmed)
+				if err == nil {
+					out[i] = json.RawMessage(updated)
+				}
+			}
+		case "reasoning":
+			// A compact checkpoint supersedes old opaque reasoning state. Keeping
+			// only its visible summary prevents ciphertext from refilling context.
+			if summary := item.Get("summary"); summary.IsArray() && len(summary.Array()) > 0 {
+				message := []byte(`{"type":"message","role":"assistant","content":[{"type":"output_text","text":""}]}`)
+				message, _ = sjson.SetBytes(message, "content.0.text", extractItemText(item))
+				out[i] = json.RawMessage(message)
+			} else {
+				out[i] = json.RawMessage(`{"type":"message","role":"assistant","content":[{"type":"output_text","text":"[Earlier hidden reasoning was retired at the context checkpoint.]"}]}`)
+			}
+		}
+	}
+	return out
+}
+
+func buildAggressiveLocalCompactionReplacement(items []json.RawMessage, maxSummaryChars int, reason string) []json.RawMessage {
+	return buildBoundedLocalCompactionReplacement(items, maxSummaryChars, reason, 15, 4_000, true)
+}
+
+func buildBoundedLocalCompactionReplacement(items []json.RawMessage, maxSummaryChars int, reason string, tailLimit, toolOutputMaxChars int, aggressive bool) []json.RawMessage {
+	if len(items) == 0 {
+		return nil
+	}
+	if maxSummaryChars <= 0 {
+		maxSummaryChars = defaultClaudeLocalSummaryChars
+	}
+	userIndex := lastUserMessageIndex(items)
+	if userIndex < 0 {
+		tailStart := expandTailStartForToolPairs(items, maxInt(0, len(items)-tailLimit), 0)
+		summary := summarizeContextItems(items[:tailStart], maxSummaryChars)
+		text := localCheckpointText(summary, reason, aggressive)
+		return append([]json.RawMessage{localCheckpointMessage(text)}, normalizeToolPairs(truncateLocalTailWithLimit(items[tailStart:], toolOutputMaxChars))...)
+	}
+	tailStart := maxInt(userIndex+1, len(items)-tailLimit)
+	tailStart = expandTailStartForToolPairs(items, tailStart, userIndex+1)
+	summaryItems := make([]json.RawMessage, 0, tailStart-1)
+	summaryItems = append(summaryItems, items[:userIndex]...)
+	if userIndex+1 < tailStart {
+		summaryItems = append(summaryItems, items[userIndex+1:tailStart]...)
+	}
+	summary := summarizeContextItems(summaryItems, maxSummaryChars)
+	text := localCheckpointText(summary, reason, aggressive)
+	replacement := []json.RawMessage{localCheckpointMessage(text), json.RawMessage(bytes.Clone(items[userIndex]))}
+	tail := append(replacement, truncateLocalTailWithLimit(items[tailStart:], toolOutputMaxChars)...)
+	return normalizeToolPairs(tail)
+}
+
+func buildSemanticCompactionReplacement(items []json.RawMessage, summary string) []json.RawMessage {
+	summary = strings.TrimSpace(summary)
+	if len(items) == 0 || summary == "" {
+		return nil
+	}
+	userIndex := lastUserMessageIndex(items)
+	if userIndex < 0 {
+		return []json.RawMessage{localCheckpointMessage("[Claudex semantic context checkpoint]\n" + summary)}
+	}
+	tailStart := expandTailStartForToolPairs(items, maxInt(userIndex+1, len(items)-24), userIndex+1)
+	replacement := []json.RawMessage{
+		localCheckpointMessage("[Claudex semantic context checkpoint]\n" + summary + "\n\nThe following user message and tool tail are authoritative."),
+		json.RawMessage(bytes.Clone(items[userIndex])),
+	}
+	replacement = append(replacement, truncateLocalTail(items[tailStart:])...)
+	return normalizeToolPairs(replacement)
+}
+
+func localCheckpointText(summary, reason string, aggressive bool) string {
+	reason = compactWhitespace(reason)
+	if len(reason) > 512 {
+		reason = truncateUTF8(reason, 512)
+	}
+	if reason == "" {
+		if aggressive {
+			reason = "emergency context checkpoint"
+		} else {
+			reason = "automatic context checkpoint"
+		}
+	}
+	prefix := "[Claudex context checkpoint: "
+	if aggressive {
+		prefix = "[Claudex compact emergency checkpoint: "
+	}
+	return prefix + reason + "]\n" + summary + "\n\nThe next user message and tool tail are authoritative. Continue the current task without redoing completed work."
+}
+
+func localCheckpointMessage(text string) json.RawMessage {
+	message := []byte(`{"type":"message","role":"user","content":[{"type":"input_text","text":""}]}`)
+	message, _ = sjson.SetBytes(message, "content.0.text", text)
+	return json.RawMessage(message)
+}
+
+func expandTailStartForToolPairs(items []json.RawMessage, start, minimum int) int {
+	if start < minimum {
+		start = minimum
+	}
+	if start > len(items) {
+		start = len(items)
+	}
+	callPositions := make(map[string]int)
+	for index, raw := range items {
+		if key, ok := contextToolCallKey(gjson.ParseBytes(raw)); ok {
+			callPositions[key] = index
+		}
+	}
+	for {
+		expanded := start
+		for _, raw := range items[start:] {
+			key, ok := contextToolOutputKey(gjson.ParseBytes(raw))
+			if !ok {
+				continue
+			}
+			if position, exists := callPositions[key]; exists && position >= minimum && position < expanded {
+				expanded = position
+			}
+		}
+		if expanded == start {
+			return start
+		}
+		start = expanded
+	}
+}
+
+func normalizeToolPairs(items []json.RawMessage) []json.RawMessage {
+	calls := make(map[string]gjson.Result)
+	outputs := make(map[string]struct{})
+	for _, raw := range items {
+		item := gjson.ParseBytes(raw)
+		if key, ok := contextToolCallKey(item); ok {
+			calls[key] = item
+		}
+		if key, ok := contextToolOutputKey(item); ok {
+			outputs[key] = struct{}{}
+		}
+	}
+	normalized := make([]json.RawMessage, 0, len(items)+4)
+	for _, raw := range items {
+		item := gjson.ParseBytes(raw)
+		if key, ok := contextToolOutputKey(item); ok {
+			if _, exists := calls[key]; !exists {
+				continue
+			}
+		}
+		normalized = append(normalized, json.RawMessage(bytes.Clone(raw)))
+		if key, ok := contextToolCallKey(item); ok {
+			if _, exists := outputs[key]; !exists {
+				normalized = append(normalized, abortedToolOutput(item))
+			}
+		}
+	}
+	return normalized
+}
+
+func contextToolCallKey(item gjson.Result) (string, bool) {
+	callID := strings.TrimSpace(item.Get("call_id").String())
+	if callID == "" {
+		return "", false
+	}
+	switch item.Get("type").String() {
+	case "function_call", "local_shell_call":
+		return "function:" + callID, true
+	case "custom_tool_call":
+		return "custom:" + callID, true
+	case "tool_search_call":
+		return "tool-search:" + callID, true
+	default:
+		return "", false
+	}
+}
+
+func contextToolOutputKey(item gjson.Result) (string, bool) {
+	callID := strings.TrimSpace(item.Get("call_id").String())
+	if callID == "" {
+		return "", false
+	}
+	switch item.Get("type").String() {
+	case "function_call_output":
+		return "function:" + callID, true
+	case "custom_tool_call_output":
+		return "custom:" + callID, true
+	case "tool_search_output":
+		return "tool-search:" + callID, true
+	default:
+		return "", false
+	}
+}
+
+func abortedToolOutput(call gjson.Result) json.RawMessage {
+	callID := call.Get("call_id").String()
+	message := "[Claudex omitted this tool result while normalizing a context checkpoint; treat the call as aborted.]"
+	switch call.Get("type").String() {
+	case "custom_tool_call":
+		output := []byte(`{"type":"custom_tool_call_output","call_id":"","output":""}`)
+		output, _ = sjson.SetBytes(output, "call_id", callID)
+		output, _ = sjson.SetBytes(output, "output", message)
+		if name := call.Get("name").String(); name != "" {
+			output, _ = sjson.SetBytes(output, "name", name)
+		}
+		return json.RawMessage(output)
+	case "tool_search_call":
+		output := []byte(`{"type":"tool_search_output","call_id":"","status":"completed","execution":"client","tools":[]}`)
+		output, _ = sjson.SetBytes(output, "call_id", callID)
+		return json.RawMessage(output)
+	default:
+		output := []byte(`{"type":"function_call_output","call_id":"","output":""}`)
+		output, _ = sjson.SetBytes(output, "call_id", callID)
+		output, _ = sjson.SetBytes(output, "output", message)
+		return json.RawMessage(output)
+	}
+}
+
+func truncateUTF8(value string, maxBytes int) string {
+	if maxBytes <= 0 || len(value) <= maxBytes {
+		return value
+	}
+	cut := maxBytes
+	for cut > 0 && !utf8.RuneStart(value[cut]) {
+		cut--
+	}
+	return value[:cut]
+}
+
+func summarizeContextItems(items []json.RawMessage, maxChars int) string {
+	if len(items) == 0 {
+		return "No earlier model-visible items required summarization."
+	}
+	lines := make([]string, 0, len(items))
+	for _, raw := range items {
+		item := gjson.ParseBytes(raw)
+		kind := item.Get("type").String()
+		var line string
+		switch kind {
+		case "message":
+			line = strings.ToUpper(item.Get("role").String()) + ": " + extractItemText(item)
+		case "function_call", "custom_tool_call":
+			line = "TOOL CALL " + item.Get("name").String() + ": " + firstNonEmpty(item.Get("arguments").String(), item.Get("input").Raw)
+		case "function_call_output", "custom_tool_call_output":
+			line = "TOOL RESULT " + firstNonEmpty(item.Get("call_id").String(), item.Get("id").String()) + ": " + item.Get("output").String()
+		case "compaction", "compaction_summary":
+			line = "EARLIER COMPACTION CHECKPOINT PRESENT"
+		case "reasoning":
+			if text := extractItemText(item); text != "" {
+				line = "REASONING SUMMARY: " + text
+			}
+		}
+		line = compactWhitespace(line)
+		if line != "" {
+			if len(line) > 2_000 {
+				line = truncateUTF8(line, 2_000) + " ..."
+			}
+			lines = append(lines, line)
+		}
+	}
+	// Keep the most recent evidence when the deterministic fallback must cap
+	// its summary. Remote compaction remains the primary semantic path.
+	var selected []string
+	used := 0
+	for i := len(lines) - 1; i >= 0; i-- {
+		cost := len(lines[i]) + 1
+		if used+cost > maxChars && len(selected) > 0 {
+			break
+		}
+		selected = append(selected, lines[i])
+		used += cost
+	}
+	for left, right := 0, len(selected)-1; left < right; left, right = left+1, right-1 {
+		selected[left], selected[right] = selected[right], selected[left]
+	}
+	return strings.Join(selected, "\n")
+}
+
+func extractItemText(item gjson.Result) string {
+	var texts []string
+	content := item.Get("content")
+	if content.Type == gjson.String {
+		return content.String()
+	}
+	for _, part := range content.Array() {
+		if text := part.Get("text").String(); text != "" {
+			texts = append(texts, text)
+		}
+	}
+	for _, part := range item.Get("summary").Array() {
+		if text := part.Get("text").String(); text != "" {
+			texts = append(texts, text)
+		}
+	}
+	return strings.Join(texts, "\n")
+}
+
+func compactWhitespace(value string) string {
+	return strings.Join(strings.Fields(value), " ")
+}
+
+func firstNonEmpty(values ...string) string {
+	for _, value := range values {
+		if strings.TrimSpace(value) != "" {
+			return value
+		}
+	}
+	return ""
+}
+
+func expandClaudeContextPath(path string) string {
+	path = strings.TrimSpace(os.ExpandEnv(path))
+	if path == "~" {
+		return claudeContextHomeDir()
+	}
+	if strings.HasPrefix(path, "~/") || strings.HasPrefix(path, `~\`) {
+		return filepath.Join(claudeContextHomeDir(), path[2:])
+	}
+	return path
+}
+
+func claudeContextHomeDir() string {
+	if home, err := os.UserHomeDir(); err == nil && strings.TrimSpace(home) != "" {
+		return home
+	}
+	return firstNonEmpty(os.Getenv("USERPROFILE"), os.Getenv("HOME"))
+}
+
+func maxInt(left, right int) int {
+	if left > right {
+		return left
+	}
+	return right
+}
+
+func minInt(left, right int) int {
+	if left < right {
+		return left
+	}
+	return right
+}
+
+func maxInt64(left, right int64) int64 {
+	if left > right {
+		return left
+	}
+	return right
+}
