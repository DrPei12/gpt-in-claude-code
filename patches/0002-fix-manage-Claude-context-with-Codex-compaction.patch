+
+func TestCodexClaudeContextIgnoresNonClaudeSources(t *testing.T) {
+	executor := NewCodexExecutor(testCodexClaudeContextConfig(t.TempDir(), 2_000, 50))
+	body := []byte(`{"input":[{"type":"message","role":"user","content":"hello"}]}`)
+	got, preparation, err := executor.prepareCodexClaudeContext(context.Background(), cliproxyexecutor.Request{Payload: body}, cliproxyexecutor.Options{
+		SourceFormat: sdktranslator.FormatOpenAIResponse,
+		Headers:      http.Header{"X-Claude-Code-Session-Id": []string{"not-claude"}},
+	}, "gpt-5.6-sol", body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if preparation != nil || string(got) != string(body) {
+		t.Fatalf("non-Claude request was modified: preparation=%+v body=%s", preparation, got)
+	}
+}
+
+func testCodexClaudeContextConfig(stateDir string, contextWindow int64, autoPercent int) *config.Config {
+	return &config.Config{
+		SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll},
+		Codex: config.CodexConfig{ClaudeCodeContext: config.ClaudeCodeContextConfig{
+			Enabled:                       true,
+			StateDir:                      stateDir,
+			ContextWindow:                 contextWindow,
+			EffectiveContextWindowPercent: 95,
+			AutoCompactPercent:            autoPercent,
+			PostCompactPercent:            40,
+		}},
+	}
+}
