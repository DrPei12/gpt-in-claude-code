+	})
+	first, err := PrepareClaudeCodeContext(context.Background(), cfg, "test-model", nil, headers, body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = first.InstallLocalCompaction("test irreducible turn"); err != nil {
+		t.Fatal(err)
+	}
+	second, err := PrepareClaudeCodeContext(context.Background(), cfg, "test-model", nil, headers, body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !second.NeedsCompaction || !second.CompactionAttempted {
