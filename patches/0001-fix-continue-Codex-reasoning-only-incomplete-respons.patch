+// doCodexRequestWithTransportRetry retries only failures returned by
+// http.Client.Do before an HTTP response exists. Once a response has started,
+// the stream is never replayed here because doing so could duplicate already
+// emitted output. Requests built by cacheHelper use bytes.Reader, so GetBody is
+// available for safe body recreation.
+func doCodexRequestWithTransportRetry(ctx context.Context, cfg *config.Config, client *http.Client, req *http.Request) (*http.Response, error) {
+	if client == nil {
+		return nil, fmt.Errorf("codex executor: HTTP client is nil")
+	}
+	if req == nil {
+		return nil, fmt.Errorf("codex executor: request is nil")
+	}
+
+	retries := 0
+	if cfg != nil && cfg.RequestRetry > 0 {
+		retries = cfg.RequestRetry
+	}
+	// Keep the executor-local retry bounded even if the general retry setting
+	// is accidentally configured to a very large value.
+	if retries > 6 {
+		retries = 6
+	}
+
+	currentReq := req
+	for attempt := 0; ; attempt++ {
+		resp, err := client.Do(currentReq)
+		if err == nil {
+			return resp, nil
+		}
+		if resp != nil && resp.Body != nil {
+			_ = resp.Body.Close()
+		}
+		if attempt >= retries || !isRetryableCodexTransportError(ctx, err) || req.GetBody == nil {
+			return nil, err
+		}
+
+		// A fast retry burst repeatedly hit the same unhealthy route on flaky
+		// TUN connections. Drop pooled connections and leave enough time for
+		// the route to recover before recreating the request body.
+		client.CloseIdleConnections()
+		delay := time.Duration(attempt+1) * time.Second
+		if delay > 5*time.Second {
+			delay = 5 * time.Second
+		}
+		timer := time.NewTimer(delay)
+		select {
+		case <-ctx.Done():
+			if !timer.Stop() {
+				select {
+				case <-timer.C:
+				default:
+				}
+			}
+			return nil, ctx.Err()
+		case <-timer.C:
+		}
+
+		body, errBody := req.GetBody()
+		if errBody != nil {
+			return nil, err
+		}
+		currentReq = req.Clone(ctx)
+		currentReq.Body = body
+		helps.LogWithRequestID(ctx).Warnf("codex transport failed before response; retrying request (%d/%d): %v", attempt+1, retries, err)
+	}
+}
+
+func isRetryableCodexTransportError(ctx context.Context, err error) bool {
+	if err == nil {
+		return false
+	}
+	if ctx != nil && ctx.Err() != nil {
+		return false
+	}
+	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return false
+	}
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+		return true
+	}
+	var netErr net.Error
+	if errors.As(err, &netErr) && netErr.Timeout() {
+		return true
+	}
+	var temporary interface {
+		Temporary() bool
+	}
+	if errors.As(err, &temporary) && temporary.Temporary() {
+		return true
+	}
+	message := strings.ToLower(err.Error())
+	for _, fragment := range []string{
+		"broken pipe",
+		"connection reset",
+		"server closed idle connection",
+		"tls handshake timeout",
+		"use of closed network connection",
+	} {
+		if strings.Contains(message, fragment) {
+			return true
+		}
+	}
+	return false
+}
