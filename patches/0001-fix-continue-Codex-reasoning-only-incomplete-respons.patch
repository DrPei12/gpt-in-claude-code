+type codexReasoningContinuationState struct {
+	enabled          bool
+	maxOutputTokens  int64
+	usedOutputTokens int64
+	continuations    int
+}
+
+func newCodexReasoningContinuationState(from sdktranslator.Format, originalPayload []byte) codexReasoningContinuationState {
+	if !sourceFormatEqual(from, sdktranslator.FormatClaude) {
+		return codexReasoningContinuationState{}
+	}
+	maxOutputTokens := gjson.GetBytes(originalPayload, "max_tokens").Int()
+	if maxOutputTokens <= 0 {
+		return codexReasoningContinuationState{}
+	}
+	return codexReasoningContinuationState{enabled: true, maxOutputTokens: maxOutputTokens}
+}
+
+// continueReasoning replays an incomplete reasoning-only response into a new
+// upstream request. Claude Code keeps seeing one logical response, while the
+// Codex backend can use as many bounded reasoning segments as the caller's
+// declared output budget permits.
+func (s *codexReasoningContinuationState) continueReasoning(body, terminalData []byte) ([]byte, bool) {
+	if s == nil || !s.enabled || s.continuations >= codexMaxReasoningContinuations {
+		return body, false
+	}
+	if gjson.GetBytes(terminalData, "type").String() != "response.incomplete" {
+		return body, false
+	}
+	reason := strings.ToLower(strings.TrimSpace(gjson.GetBytes(terminalData, "response.incomplete_details.reason").String()))
+	if reason != "max_output_tokens" && reason != "max_tokens" {
+		return body, false
+	}
+
+	output := gjson.GetBytes(terminalData, "response.output")
+	items := output.Array()
+	if !output.IsArray() || len(items) == 0 {
+		return body, false
+	}
+	for _, item := range items {
+		if item.Get("type").String() != "reasoning" || strings.TrimSpace(item.Get("encrypted_content").String()) == "" {
+			return body, false
+		}
+	}
+
+	segmentTokens := gjson.GetBytes(terminalData, "response.usage.output_tokens").Int()
+	if segmentTokens > 0 && s.usedOutputTokens+segmentTokens >= s.maxOutputTokens {
+		s.usedOutputTokens += segmentTokens
+		return body, false
+	}
+
+	updated := body
+	seen := make(map[string]struct{})
+	for _, existing := range gjson.GetBytes(body, "input").Array() {
+		if existing.Get("type").String() != "reasoning" {
+			continue
+		}
+		if encrypted := strings.TrimSpace(existing.Get("encrypted_content").String()); encrypted != "" {
+			seen[encrypted] = struct{}{}
+		}
+	}
+	for _, item := range items {
+		encrypted := strings.TrimSpace(item.Get("encrypted_content").String())
+		if _, ok := seen[encrypted]; ok {
+			continue
+		}
+		updated, _ = sjson.SetRawBytes(updated, "input.-1", []byte(item.Raw))
+		seen[encrypted] = struct{}{}
+	}
+
+	s.usedOutputTokens += segmentTokens
+	s.continuations++
+	return updated, true
+}
