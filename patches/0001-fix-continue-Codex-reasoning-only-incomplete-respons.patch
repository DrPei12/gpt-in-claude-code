+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexExecutorExecuteContinuesReasoningOnlyIncompleteForClaude(t *testing.T) {
+	encryptedContent := validCodexReasoningEncryptedContentForTestSeed(41)
+	server, calls, secondBody := newCodexReasoningContinuationTestServer(t, encryptedContent)
+	defer server.Close()
+
+	executor := NewCodexExecutor(&config.Config{})
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{
+		"base_url": server.URL,
+		"api_key":  "test",
+	}}
+
+	resp, err := executor.Execute(context.Background(), auth, cliproxyexecutor.Request{
+		Model: "gpt-5.6-sol",
+		Payload: []byte(`{
+			"model":"gpt-5.6-sol",
+			"max_tokens":128000,
+			"thinking":{"type":"adaptive"},
+			"output_config":{"effort":"high"},
+			"messages":[{"role":"user","content":"analyze this"}]
+		}`),
+	}, cliproxyexecutor.Options{
+		SourceFormat: sdktranslator.FromString("claude"),
+		Stream:       false,
+	})
+	if err != nil {
+		t.Fatalf("Execute error: %v", err)
+	}
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("upstream calls = %d, want 2", got)
+	}
+	if got := gjson.GetBytes(resp.Payload, "stop_reason").String(); got != "end_turn" {
+		t.Fatalf("stop_reason = %q, want end_turn; payload=%s", got, resp.Payload)
+	}
+	if got := gjson.GetBytes(resp.Payload, "content.0.text").String(); got != "done" {
+		t.Fatalf("content[0].text = %q, want done; payload=%s", got, resp.Payload)
+	}
+	if !bytes.Contains(secondBody(), []byte(encryptedContent)) {
+		t.Fatalf("continuation request did not replay encrypted reasoning: %s", secondBody())
+	}
+}
+
+func TestCodexExecutorExecuteStreamContinuesReasoningOnlyIncompleteWithinOneClaudeMessage(t *testing.T) {
+	encryptedContent := validCodexReasoningEncryptedContentForTestSeed(42)
+	server, calls, secondBody := newCodexReasoningContinuationTestServer(t, encryptedContent)
+	defer server.Close()
+
+	executor := NewCodexExecutor(&config.Config{})
+	auth := &cliproxyauth.Auth{Attributes: map[string]string{
+		"base_url": server.URL,
+		"api_key":  "test",
+	}}
+
+	result, err := executor.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{
+		Model: "gpt-5.6-sol",
+		Payload: []byte(`{
+			"model":"gpt-5.6-sol",
+			"max_tokens":128000,
+			"thinking":{"type":"adaptive"},
+			"output_config":{"effort":"high"},
+			"messages":[{"role":"user","content":"analyze this"}],
+			"stream":true
+		}`),
+	}, cliproxyexecutor.Options{
+		SourceFormat: sdktranslator.FromString("claude"),
+		Stream:       true,
+	})
+	if err != nil {
+		t.Fatalf("ExecuteStream error: %v", err)
+	}
+
+	var output strings.Builder
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("stream chunk error: %v", chunk.Err)
+		}
+		output.Write(chunk.Payload)
+	}
+	got := output.String()
+	if upstreamCalls := calls.Load(); upstreamCalls != 2 {
+		t.Fatalf("upstream calls = %d, want 2; stream=%s", upstreamCalls, got)
+	}
+	if count := strings.Count(got, `"type":"message_start"`); count != 1 {
+		t.Fatalf("message_start count = %d, want 1; stream=%s", count, got)
+	}
+	if count := strings.Count(got, `"type":"message_stop"`); count != 1 {
+		t.Fatalf("message_stop count = %d, want 1; stream=%s", count, got)
+	}
+	if strings.Contains(got, `"stop_reason":"max_tokens"`) {
+		t.Fatalf("reasoning continuation exposed max_tokens to Claude Code: %s", got)
+	}
+	if !strings.Contains(got, `"text":"done"`) {
+		t.Fatalf("missing final text in stream: %s", got)
+	}
+	if !bytes.Contains(secondBody(), []byte(encryptedContent)) {
+		t.Fatalf("continuation request did not replay encrypted reasoning: %s", secondBody())
+	}
+}
+
+func newCodexReasoningContinuationTestServer(t *testing.T, encryptedContent string) (*httptest.Server, *atomic.Int32, func() []byte) {
+	t.Helper()
+
+	var calls atomic.Int32
+	var bodyMu sync.Mutex
+	var continuationBody []byte
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request body: %v", err)
+			w.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		call := calls.Add(1)
+		w.Header().Set("Content-Type", "text/event-stream")
+		if call == 1 {
+			_, _ = w.Write([]byte(`data: {"type":"response.created","response":{"id":"resp_reasoning","model":"gpt-5.6-sol"}}` + "\n"))
+			_, _ = w.Write([]byte(`data: {"type":"response.reasoning_summary_part.added"}` + "\n"))
+			_, _ = w.Write([]byte(`data: {"type":"response.reasoning_summary_text.delta","delta":"Still analyzing"}` + "\n"))
+			_, _ = w.Write([]byte(`data: {"type":"response.reasoning_summary_part.done"}` + "\n"))
+			reasoningItem := `{"id":"rs_reasoning","type":"reasoning","status":"incomplete","summary":[{"type":"summary_text","text":"Still analyzing"}],"encrypted_content":"` + encryptedContent + `"}`
+			_, _ = w.Write([]byte(`data: {"type":"response.output_item.done","output_index":0,"item":` + reasoningItem + `}` + "\n"))
+			_, _ = w.Write([]byte(`data: {"type":"response.incomplete","response":{"id":"resp_reasoning","model":"gpt-5.6-sol","status":"incomplete","incomplete_details":{"reason":"max_output_tokens"},"output":[],"usage":{"input_tokens":689,"output_tokens":701,"total_tokens":1390}}}` + "\n\n"))
+			return
+		}
+
+		bodyMu.Lock()
+		continuationBody = append([]byte(nil), body...)
+		bodyMu.Unlock()
+		_, _ = w.Write([]byte(`data: {"type":"response.created","response":{"id":"resp_done","model":"gpt-5.6-sol"}}` + "\n"))
+		_, _ = w.Write([]byte(`data: {"type":"response.output_item.done","output_index":0,"item":{"id":"msg_done","type":"message","role":"assistant","status":"completed","content":[{"type":"output_text","text":"done","annotations":[]}]}}` + "\n"))
+		_, _ = w.Write([]byte(`data: {"type":"response.completed","response":{"id":"resp_done","model":"gpt-5.6-sol","status":"completed","output":[],"usage":{"input_tokens":732,"output_tokens":12,"total_tokens":744}}}` + "\n\n"))
+	}))
+
+	return server, &calls, func() []byte {
+		bodyMu.Lock()
+		defer bodyMu.Unlock()
+		return append([]byte(nil), continuationBody...)
+	}
+}
