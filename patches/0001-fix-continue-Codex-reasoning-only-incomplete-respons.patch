+
+type codexRetryRoundTripperFunc func(*http.Request) (*http.Response, error)
+
+func (f codexRetryRoundTripperFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func TestDoCodexRequestWithTransportRetry_ReplaysBodyAfterEOF(t *testing.T) {
+	const payload = `{"model":"gpt-5.6-sol","stream":true}`
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodPost, "https://example.com/responses", bytes.NewReader([]byte(payload)))
+	if err != nil {
+		t.Fatalf("NewRequestWithContext error: %v", err)
+	}
+
+	var calls atomic.Int32
+	client := &http.Client{Transport: codexRetryRoundTripperFunc(func(current *http.Request) (*http.Response, error) {
+		call := calls.Add(1)
+		body, errRead := io.ReadAll(current.Body)
+		if errRead != nil {
+			t.Fatalf("ReadAll error: %v", errRead)
+		}
+		if string(body) != payload {
+			t.Fatalf("body = %q, want %q", body, payload)
+		}
+		if call == 1 {
+			return nil, io.EOF
+		}
+		return &http.Response{
+			StatusCode: http.StatusOK,
+			Header:     make(http.Header),
+			Body:       io.NopCloser(bytes.NewReader([]byte("ok"))),
+			Request:    current,
+		}, nil
+	})}
+
+	resp, err := doCodexRequestWithTransportRetry(context.Background(), &config.Config{RequestRetry: 1}, client, req)
+	if err != nil {
+		t.Fatalf("doCodexRequestWithTransportRetry error: %v", err)
+	}
+	defer resp.Body.Close()
+	if got := calls.Load(); got != 2 {
+		t.Fatalf("calls = %d, want 2", got)
+	}
+}
+
+func TestDoCodexRequestWithTransportRetry_DoesNotRetryNonTransportError(t *testing.T) {
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodPost, "https://example.com/responses", bytes.NewReader([]byte(`{}`)))
+	if err != nil {
+		t.Fatalf("NewRequestWithContext error: %v", err)
+	}
+
+	sentinel := errors.New("invalid local request configuration")
+	var calls atomic.Int32
+	client := &http.Client{Transport: codexRetryRoundTripperFunc(func(*http.Request) (*http.Response, error) {
+		calls.Add(1)
+		return nil, sentinel
+	})}
+
+	_, err = doCodexRequestWithTransportRetry(context.Background(), &config.Config{RequestRetry: 3}, client, req)
+	if !errors.Is(err, sentinel) {
+		t.Fatalf("error = %v, want sentinel", err)
+	}
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("calls = %d, want 1", got)
+	}
+}
+
+func TestDoCodexRequestWithTransportRetry_StopsWhenContextCanceled(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, "https://example.com/responses", bytes.NewReader([]byte(`{}`)))
+	if err != nil {
