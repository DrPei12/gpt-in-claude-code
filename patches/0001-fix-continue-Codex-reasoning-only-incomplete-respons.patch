+		calls.Add(1)
+		cancel()
+		return nil, io.EOF
+	})}
+
+	_, err = doCodexRequestWithTransportRetry(ctx, &config.Config{RequestRetry: 3}, client, req)
+	if !errors.Is(err, io.EOF) {
+		t.Fatalf("error = %v, want EOF", err)
+	}
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("calls = %d, want 1", got)
+	}
+}
