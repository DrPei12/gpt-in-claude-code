# Never commit a real token. The installer generates this localhost-only key
# automatically; users do not need to set it.
GICC_PROXY_TOKEN=replace-with-your-local-cliproxyapi-key

# Optional overrides:
# GICC_PROXY_URL=http://127.0.0.1:8318
# GICC_ALLOW_REMOTE_PROXY=0
# GICC_PROXY_CONFIG=~/.config/gpt-in-claude-code/cliproxyapi.yaml
# GICC_PROXY_BIN=~/.config/gpt-in-claude-code/bin/cliproxyapi
# GICC_CODEX_AUTH_DIR=~/.config/gpt-in-claude-code/codex-accounts
# GICC_NODE_BIN=~/.config/gpt-in-claude-code/node/bin
# GICC_PERMISSION_MODE=auto
# GICC_AUTO_MODE_MODEL=gpt-5.6-terra
# GICC_BACKGROUND_MODEL=gpt-5.6-luna
# GICC_MAX_TOOL_USE_CONCURRENCY=1
# GICC_MAX_AGENT_CONCURRENCY=1
# GICC_MAX_RETRIES=4
# GICC_MAX_OUTPUT_TOKENS=128000
# GICC_CONTEXT_WINDOW=272000
# GICC_AUTO_COMPACT_WINDOW=244800
# GICC_MOUSE_POINTER_SHAPE=pointer
# GICC_USAGE_DISPLAY=on
# GICC_USAGE_REFRESH_SECONDS=300
# GICC_USAGE_TIMEOUT_SECONDS=8
# GICC_USAGE_MAX_STALE_SECONDS=86400
# GICC_USAGE_ALERT_PERCENT=20
# GICC_USAGE_SOURCE=auto
# GICC_CLAUDE_AUTO_UPDATE=on
# GICC_CLAUDE_UPDATE_INTERVAL_SECONDS=86400
# GICC_AUTO_UPDATE=on
# GICC_UPDATE_INTERVAL_SECONDS=86400
# GICC_DISABLE_INTERACTIVE_LOGIN=0
# GICC_PLAN_MODE_POLICY=conservative
# GICC_SKILL_BRIDGE=on
# GICC_INSTRUCTION_BRIDGE=on
# GICC_SKILL_PLUGINS=on
# GICC_SKILL_DOLLAR_REFERENCES=on
# GICC_CLAUDE_CONFIG_DIR=~/.claude
# GICC_SKILL_EXTRA_DIRS=/absolute/shared/skills
# GICC_CODEX_AUTH_FILE=/absolute/path/to/a/codex-oauth-file.json
# GICC_CHROME_CONFIG_DIR=/absolute/path/to/a/direct-claude-profile
